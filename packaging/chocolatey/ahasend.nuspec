<?xml version="1.0" encoding="utf-8"?>
<!-- scripts/choco-package.sh fills in this nuspec for a release -->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>ahasend</id>
    <version>@VERSION@</version>
    <packageSourceUrl>https://github.com/AhaSend/ahasend-cli/tree/v@VERSION@/packaging/chocolatey</packageSourceUrl>
    <owners>AhaSend</owners>
    <title>AhaSend CLI</title>
    <authors>AhaSend</authors>
    <projectUrl>https://ahasend.com</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/AhaSend/ahasend-cli@v@VERSION@/packaging/chocolatey/icon.png</iconUrl>
    <licenseUrl>https://github.com/AhaSend/ahasend-cli/blob/v@VERSION@/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/AhaSend/ahasend-cli</projectSourceUrl>
    <docsUrl>https://ahasend.com/docs/cli</docsUrl>
    <bugTrackerUrl>https://github.com/AhaSend/ahasend-cli/issues</bugTrackerUrl>
    <tags>ahasend cli email smtp transactional-email</tags>
    <summary>Send email and manage your AhaSend account from the command line.</summary>
    <description>The AhaSend CLI sends email through [AhaSend](https://ahasend.com), the transactional email service, and manages domains, webhooks, routes, suppressions, SMTP credentials, API keys, sub-accounts, contacts, lists, templates and campaigns, with JSON, table, CSV and plain text output.

The package installs the `ahasend` command. It works on Windows x64, and on ARM64 under emulation.

## Usage

```powershell
# Log in with an API key from https://dash.ahasend.com
ahasend auth login

# Check the key and the connection
ahasend ping

# Send a test email in sandbox mode, from a domain you verified
ahasend messages send --from you@yourdomain.com --to recipient@example.com --subject "Hello" --text "It works." --sandbox

# See every command
ahasend --help
```

